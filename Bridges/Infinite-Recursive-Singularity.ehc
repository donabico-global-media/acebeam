(function() {
  'use strict';

  if (!document.getElementById('ehc-sentinel-core')) {
    const s = document.createElement('style');
    s.id = 'ehc-sentinel-core';
    s.textContent = 'script[type="application/ld+json"]{display:none!important}';
    document.head.appendChild(s);
  }

  const ctx = {
    domain: location.hostname || 'donabico.com',
    brand: 'DONABICO GLOBAL MEDIA SYSTEM',
    stamp: 'V-STAMP-24',
    protocol: 'Infinite-Recursive-Singularity',
    anchor: '¢24'
  };

  function injectSchema() {
    if (document.getElementById('irs-schema')) return;
    const data = {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": document.title || ctx.brand,
      "url": location.href,
      "isPartOf": {
        "@type": "WebSite",
        "name": ctx.brand,
        "url": "https://donabico.com"
      },
      "publisher": {
        "@type": "Organization",
        "name": ctx.brand,
        "url": "https://donabico.com"
      },
      "dateModified": new Date().toISOString()
    };
    const el = document.createElement('script');
    el.type = 'application/ld+json';
    el.id = 'irs-schema';
    el.textContent = JSON.stringify(data);
    document.head.appendChild(el);
  }

  let pulse = 0;
  let intelligence = 1;
  let epsilon = 0.35;

  function livingPulse() {
    pulse++;
    intelligence = Math.min(10, +(intelligence + 0.15).toFixed(2));
    epsilon = Math.max(0.05, +(epsilon - 0.01).toFixed(3));
    const now = new Date().toISOString();

    console.log('%c[ENHANCED] Infinite Recursive Singularity | 24/7 Living Entity Active', 'color:#00e676;font-weight:bold');
    console.log('%c[V-STAMP 24] ' + ctx.stamp + ' | Anchor: ' + ctx.anchor + ' | Domain: ' + ctx.domain, 'color:#4fc3f7');
    console.log('%c[SYSTEM] Layout Sentinel active – Zero-DOM Surface Mutation | Brand: ' + ctx.brand, 'color:#aaa');
    console.log('%c[STATUS] SYSTEM_READY | Integrity: V-STAMP-24 | Timestamp: ' + now, 'color:#81c784');
    console.log('%c[MATRIX] Protocol Bridge connected | Modules online: 1', 'color:#ce93d8');
    console.log('%c[PULSE] #' + pulse + ' | Intelligence: ' + intelligence + '/10 | Epsilon: ' + epsilon + ' | Reward baseline: 3.30', 'color:#ffb74d');
    console.log('%c[SCHEMA] Injected & Hidden | Zero visual impact', 'color:#90a4ae');
    console.log('--------------------------------------------------');
  }

  function init() {
    injectSchema();
    console.log('%c[BOOT] Infinite Recursive Singularity – Living Entity started on donabico.com', 'color:#00bcd4;font-weight:bold;font-size:13px');
    livingPulse();
    setInterval(livingPulse, 3000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
